# --- Infraestructura ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672
REDIS_URL=redis://localhost:6379

# Una base por microservicio (pueden vivir en el mismo servidor PostgreSQL).
IDENTITY_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/malaika_identity
CATALOG_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/malaika_catalog
ORDERS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/malaika_orders
PAYMENTS_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/malaika_payments

# --- Seguridad ---
# Cambialos en producción: openssl rand -base64 48
JWT_SECRET=cambiar-este-secreto-jwt
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
# Cifra las credenciales de Mercado Pago de cada comercio.
ENCRYPTION_KEY=cambiar-esta-clave-de-cifrado

# --- API Gateway ---
PORT=3100
# Orígenes permitidos para CORS, separados por coma.
CORS_ORIGINS=http://localhost:4200,http://localhost:3001
# Comercio a usar cuando el dominio no coincide con ninguno (útil en desarrollo con localhost).
DEFAULT_TENANT_SLUG=malaika
# URL pública de la API, para que Mercado Pago avise los pagos (webhooks).
PUBLIC_API_URL=http://localhost:3100

# --- Imágenes que suben los comercios ---
# local: se guardan en UPLOADS_DIR y el gateway las sirve en /api/uploads.
# s3: cualquier almacenamiento compatible con S3 (AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO).
STORAGE_DRIVER=local
UPLOADS_DIR=uploads
# URL pública de las imágenes locales (por defecto PUBLIC_API_URL + /api/uploads).
PUBLIC_UPLOADS_URL=
UPLOAD_MAX_MB=15
S3_BUCKET=
S3_REGION=auto
# Vacío para AWS. R2: https://<account-id>.r2.cloudflarestorage.com · Spaces: https://nyc3.digitaloceanspaces.com
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Dominio público del bucket o de la CDN, por ejemplo https://media.malaika.com.ar
S3_PUBLIC_URL=

# --- Pedidos ---
# Horas que se reserva el stock esperando el pago.
ORDER_TTL_HOURS_MERCADO_PAGO=2
ORDER_TTL_HOURS_BANK_TRANSFER=48

# --- Pagos ---
# true: simula pagos aprobados sin llamar a Mercado Pago (solo desarrollo).
PAYMENTS_SIMULATION=false

# --- Seed inicial ---
SUPERADMIN_EMAIL=admin@plataforma.local
SUPERADMIN_PASSWORD=cambiar-esta-clave
MALAIKA_ADMIN_EMAIL=admin@malaika.local
MALAIKA_ADMIN_PASSWORD=cambiar-esta-clave
