{
  "name": "@malaika/notifications-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node --enable-source-maps dist/main.js",
    "start:dev": "tsc -p tsconfig.build.json && concurrently -k -r \"tsc -w -p tsconfig.build.json --preserveWatchOutput\" \"node --watch --env-file-if-exists=../../.env --enable-source-maps dist/main.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@malaika/common": "*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/microservices": "^12.0.1",
    "@nestjs/schedule": "^12.0.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "amqp-connection-manager": "^5.0.0",
    "amqplib": "^0.10.9",
    "nodemailer": "^10.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.2",
    "dotenv": "^17.2.3",
    "prisma": "^7.10.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
