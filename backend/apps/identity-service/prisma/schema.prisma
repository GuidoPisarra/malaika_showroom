// Comercios (tenants), usuarios y sesiones.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  /// Dominios desde los que se sirve la tienda (ej. malaika.com.ar, malaika.localhost).
  domains   String[]
  active    Boolean  @default(true)
  /// StoreSettings (ver @malaika/common).
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users     User[]
}

enum Role {
  CUSTOMER
  ADMIN
  SUPERADMIN
}

model User {
  id            String         @id @default(cuid())
  /// null solo para el superadmin de la plataforma.
  tenantId      String?
  tenant        Tenant?        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email         String
  passwordHash  String
  name          String
  phone         String?
  role          Role           @default(CUSTOMER)
  active        Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  refreshTokens RefreshToken[]

  @@unique([tenantId, email])
  @@index([email])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}
